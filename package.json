    "dotenv": "^18.0.9",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "discord-api-types": "^0.38.57",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
